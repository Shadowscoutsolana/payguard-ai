# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# SQLite Database Files
payguard.db
*.db
*.sqlite
*.sqlite3
*.db-journal

# Large Datasets (PaySim is ~470 MB: download it from Kaggle, never commit it)
ml/datasets/
data/*.csv
*.csv
PS_*.csv

# ML Models & Binary Weights
# The trained XGBoost bundle (~0.2 MB) IS committed so the demo runs without the PaySim download;
# backups and candidates from retraining are not.
ml/models/*.joblib
!ml/models/risk_model.joblib
ml/models/*.json
ml/models/*.pkl
ml/models/*.onnx

# Testing & Coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Streamlit
.streamlit/

# Editors, OS files, logs
.vscode/
.idea/
Thumbs.db
.DS_Store
*.log
