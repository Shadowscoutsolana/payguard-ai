# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Optional: real PYUSD transfers via scripts/fetch_pyusd_transfers.py (free key: https://etherscan.io/apis)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Buyer return flow (defaults shown; change only if you run on other hosts/ports)
PUBLIC_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:8501

# LLM Investigation Agent (Optional / Mockable)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash

# Risk Engine Thresholds
LOW_RISK_THRESHOLD=30
HIGH_RISK_THRESHOLD=70

# API access keys (>= 24 chars). Generate with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
MERCHANT_API_KEY=your_merchant_api_key_here
ANALYST_API_KEYS=analyst.demo:your_analyst_api_key_here
